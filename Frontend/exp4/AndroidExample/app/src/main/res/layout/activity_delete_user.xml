<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".DeleteUserActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AntiSocial"
            android:textColor="#7B6FFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- Warning Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E30"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DANGER ZONE"
                android:textColor="#FF4B4B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deleting an account is permanent and cannot be undone. Please proceed with caution."
                android:textColor="#C4C4D4"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- Input Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRM USER ID"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter User ID to delete"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="32dp"
            android:inputType="number"/>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Delete Permanently"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4B4B"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBackToMain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="#9B9BB4"
            android:textSize="16sp"
            android:backgroundTint="#1E1E30"/>

    </LinearLayout>

</ScrollView>