<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F0F1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Moderator Login"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etModeratorEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Moderator email"
        android:inputType="textEmailAddress"
        android:textColor="#FFFFFF"
        android:textColorHint="#9B9BB4"
        android:backgroundTint="#2A2A42"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etModeratorPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:textColor="#FFFFFF"
        android:textColorHint="#9B9BB4"
        android:backgroundTint="#2A2A42"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnModeratorLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login as Moderator"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7B6FFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnModeratorLoginBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#444444" />

</LinearLayout>

