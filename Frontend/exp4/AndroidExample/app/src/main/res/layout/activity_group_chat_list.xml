<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E30"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#7B6FFF"
            android:textSize="20sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Chats"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- CREATE GROUP CHAT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E1E30">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE GROUP CHAT"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etGroupChatName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Group Chat Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etUserIds"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="User IDs (comma-separated, e.g. 1,2,3)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCreateGroupChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Group Chat"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"/>

    </LinearLayout>

    <!-- Empty state text -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading groups..."
        android:textColor="#9B9BB4"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="40dp"
        android:lineSpacingExtra="4dp"/>

    <!-- Group list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/groupListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

    </ScrollView>

</LinearLayout>

