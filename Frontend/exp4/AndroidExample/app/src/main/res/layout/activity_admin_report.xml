<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAdminReportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reported Users / Safety Violations"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAdminReportSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review user reports and update report status from the admin dashboard."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvReportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading reports..."
            android:textColor="#C4C4D4"
            android:textSize="14sp"
            android:background="#1E1E30"
            android:padding="14dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRefreshReports"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Refresh Reports"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/reportsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBackReports"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#9B9BB4"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30" />

    </LinearLayout>
</ScrollView>