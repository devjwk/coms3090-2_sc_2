<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AntiSocial"
            android:textColor="#7B6FFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_marginTop="60dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="connect differently."
            android:textColor="#9B9BB4"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="52dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/login_username_edt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="your@iastate.edu"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textEmailAddress"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/login_password_edt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="••••••••"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/login_login_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/login_signup_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Account"
            android:textColor="#7B6FFF"
            android:textSize="16sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/login_delete_user_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Delete Account"
            android:textColor="#FF5C5C"
            android:textSize="14sp"
            android:backgroundTint="#0F0F1A"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/login_moderator_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moderator Panel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/login_admin_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/login_moderator_login_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moderator Login"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6A5CFF"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

</ScrollView>