<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AntiSocial"
        android:textColor="#7B6FFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#1E1E30"
        android:padding="28dp"
        android:gravity="center">

        <!-- Profile photo -->
        <ImageView
            android:id="@+id/ivProfilePhoto"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:background="#2A2A42"
            android:layout_marginBottom="20dp"
            android:src="@android:drawable/ic_menu_gallery"/>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9B9BB4"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvMajor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9B9BB4"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C4C4D4"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvHobbies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#7B6FFF"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9B9BB4"
            android:textSize="13sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnDislike"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="✕ Dislike"
            android:textColor="#FF5C5C"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginEnd="20dp"/>

        <Button
            android:id="@+id/btnLike"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="♥ Like"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:backgroundTint="#7B6FFF"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Back"
        android:textColor="#9B9BB4"
        android:textSize="14sp"
        android:backgroundTint="#1E1E30"/>

</LinearLayout>