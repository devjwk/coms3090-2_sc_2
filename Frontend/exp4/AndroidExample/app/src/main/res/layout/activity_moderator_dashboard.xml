<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moderator Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvModeratorProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:background="#1E1E30"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:text="Loading profile..." />

        <TextView
            android:id="@+id/tvModeratorPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0B0C0"
            android:background="#1E1E30"
            android:padding="12dp"
            android:layout_marginBottom="14dp"
            android:text="Permissions: ..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Group"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCreateModeratorGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Group name"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCreateModeratorGroupDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCreateModeratorGroupInterests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Interests (comma separated)"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCreateModeratorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Group"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Managed Groups"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutModeratorGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRefreshModeratorDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnModeratorLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#993333" />

    </LinearLayout>

</ScrollView>

