<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E30"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#7B6FFF"
            android:textSize="20sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginEnd="8dp"/>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#7B6FFF"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="👥"
                android:textSize="18sp"
                android:gravity="center"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group Chat"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to view members"
                android:textColor="#9E97FF"
                android:textSize="13sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnViewEvents"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Events"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#3C3C50" />

        <Button
            android:id="@+id/btnViewAnnouncements"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Announcements"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#3C3C50" />

        <Button
            android:id="@+id/btnManageGroupChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Manage"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#7B6FFF"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPinnedAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:background="#25253A"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPinnedAnnouncementLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pinned announcement"
            android:textColor="#9E97FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinnedAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#1E1E30">

        <EditText
            android:id="@+id/msgEdt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Message..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"/>

    </LinearLayout>

</LinearLayout>
