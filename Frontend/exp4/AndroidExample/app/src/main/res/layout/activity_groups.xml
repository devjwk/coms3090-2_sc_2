<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AntiSocial"
            android:textColor="#7B6FFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groups"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>

        <!-- Response Box -->
        <TextView
            android:id="@+id/msgResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C4C4D4"
            android:textSize="14sp"
            android:background="#1E1E30"
            android:padding="16dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="28dp"/>

        <!-- CREATE GROUP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE GROUP"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etGroupName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Group Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etGroupDesc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Description"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Group"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="32dp"/>

        <!-- GET GROUPS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GET GROUPS"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGetAllGroups"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Get All Groups"
            android:textColor="#7B6FFF"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etGetGroupId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Group ID"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnGetGroupById"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Get Group By ID"
            android:textColor="#7B6FFF"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginBottom="32dp"/>

        <!-- EDIT GROUP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT GROUP"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etEditGroupId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Group ID to Edit"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etEditGroupName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="New Group Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etEditGroupDesc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="New Description"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnEditGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Edit Group"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="32dp"/>

        <!-- DELETE GROUP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELETE GROUP"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etDeleteGroupId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Group ID to Delete"
            android:textColor="#FFFFFF"
            android:textColorHint="#555570"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnDeleteGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Delete Group"
            android:textColor="#FF5C5C"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30"
            android:layout_marginBottom="32dp"/>

        <!-- MANAGE MEMBERSHIP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEMBERSHIP MANAGEMENT"
            android:textColor="#9B9BB4"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnManageMembers"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Manage Group Members"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnGroupChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="💬  Open Group Chats"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2A2A42"
            android:layout_marginBottom="32dp"/>

        <!-- BACK -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Back"
            android:textColor="#9B9BB4"
            android:textSize="15sp"
            android:backgroundTint="#1E1E30"/>
        <Button
            android:id="@+id/btnOpenNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Notifications" />
    </LinearLayout>

</ScrollView>