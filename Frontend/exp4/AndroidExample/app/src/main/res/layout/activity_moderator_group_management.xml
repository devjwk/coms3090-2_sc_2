<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvModGroupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="Manage Group" />

        <TextView
            android:id="@+id/tvModGroupDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C2C2DE"
            android:background="#1E1E30"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:text="Loading group details..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Member Actions"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etApproveMemberId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pending member ID"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <Button
            android:id="@+id/btnApproveMember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approve Member"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etRemoveMemberId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Member ID to remove"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <Button
            android:id="@+id/btnRemoveMember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove Member"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message Moderation"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etModerationMessageId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message ID"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <Button
            android:id="@+id/btnRemoveMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove Message"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnRestoreMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore Message"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Events"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event title"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <EditText
            android:id="@+id/etEventWhen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event schedule (e.g. 2026-04-22 18:00)"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <Button
            android:id="@+id/btnScheduleEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule Event"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Announcements"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Announcement text"
            android:textColor="#FFFFFF"
            android:textColorHint="#9B9BB4"
            android:backgroundTint="#2A2A42" />

        <Button
            android:id="@+id/btnPinAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Post Announcement"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6FFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvModMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E30"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:text="Members" />

        <TextView
            android:id="@+id/tvModPendingMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E30"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:text="Pending Members" />

        <TextView
            android:id="@+id/tvModEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E30"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:text="Events" />

        <TextView
            android:id="@+id/tvModAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E30"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:text="Announcements" />

        <TextView
            android:id="@+id/tvModMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E30"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:text="Messages" />

        <Button
            android:id="@+id/btnRefreshGroupManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Group Data"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3C3C50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBackGroupManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3C3C50" />

    </LinearLayout>

</ScrollView>

